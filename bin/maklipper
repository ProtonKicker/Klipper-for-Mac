#!/bin/sh
# maklipper launcher — works straight from a git checkout or via symlink.
SELF="$0"
while [ -L "$SELF" ]; do
    L=$(readlink "$SELF")
    case "$L" in
        /*) SELF="$L" ;;
        *)  SELF=$(dirname "$SELF")/"$L" ;;
    esac
done
DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")/.." && pwd)
cd "$DIR" || exit 1
PY="${MAKLIPPER_PYTHON:-python3}"
PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m maklipper "$@"
